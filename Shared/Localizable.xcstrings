    "partner.share.privacy": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shared through iCloud, read-only: the pregnancy week and due date, upcoming check-ups (title and time) and a summary of kick counts. Never notes, symptoms, weight or cycle data."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chia sẻ qua iCloud, chỉ xem: tuần thai và ngày dự sinh, lịch khám sắp tới (tên và giờ) và tóm tắt lượt đếm cử động. Không bao giờ chia sẻ ghi chú, triệu chứng, cân nặng hay dữ liệu chu kỳ."
          }
        }
      }
    },
