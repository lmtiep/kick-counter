    "cycle.hormonalNote": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "With hormonal contraception, fertile-day predictions aren't reliable (the pill, implant and injection usually stop ovulation), so Luna Mom doesn't show them. Bleeding dates are a rough guide."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khi dùng biện pháp tránh thai bằng nội tiết tố, dự đoán ngày dễ thụ thai không còn chính xác (thuốc tránh thai, que cấy và thuốc tiêm thường làm ngừng rụng trứng), nên Luna Mom không hiển thị những ngày này. Ngày ra máu chỉ mang tính ước tính."
          }
        }
      }
    },
    "cycle.imPregnant": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I'm pregnant"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tôi đã có thai"
          }
        }
      }
    },
    "cycle.irregular.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cycles shorter than 21 days, longer than 45 days, or that vary a lot are worth talking over with a doctor."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chu kỳ ngắn hơn 21 ngày, dài hơn 45 ngày hoặc thay đổi nhiều — bạn nên trao đổi với bác sĩ."
          }
        }
      }
    },
    "cycle.irregular.title": {
      "extractionState": "manual",
      "localizations": {
