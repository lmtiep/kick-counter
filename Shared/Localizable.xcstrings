    "cycle.notContraception": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "These are the days when pregnancy is most likely. Predictions are only estimates and are not a method of contraception. If you don't want to get pregnant, always use a reliable method of contraception."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đây là những ngày dễ có thai nhất. Dự đoán chỉ là ước tính, không phải biện pháp tránh thai. Nếu không muốn có thai, hãy luôn dùng một biện pháp tránh thai đáng tin cậy."
          }
        }
      }
    },
    "cycle.notificationsOff": {
      "extractionState": "manual",
      "localizations": {
        "en": {
