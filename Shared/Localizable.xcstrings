    "onboarding.1.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap the big circle each time you feel your baby move — a kick, roll, or flutter. When you reach 10, you're done."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chạm vào vòng tròn lớn mỗi khi cảm thấy bé cử động: đạp, xoay hay trườn. Đủ 10 lần là xong."
          }
        }
      }
    },
    "onboarding.1.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Count 10 movements"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đếm 10 cử động"
          }
        }
      }
    },
    "onboarding.2.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "From week 28, count once a day at a time your baby is usually active, such as after a meal or in the evening."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Từ tuần 28, mỗi ngày đếm một lần vào lúc bé hay cử động, như sau bữa ăn hoặc buổi tối."
          }
        }
      }
    },
    "onboarding.2.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When to count"
          }
        },
        "vi": {
          "stringUnit": {
