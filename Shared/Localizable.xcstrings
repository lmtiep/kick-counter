    "onboarding.3.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If your baby is moving less than usual, contact your doctor or maternity unit right away. Don't wait for the app."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nếu thấy bé cử động ít hơn bình thường, hãy liên hệ ngay bác sĩ hoặc cơ sở y tế. Đừng chờ kết quả từ app."
          }
        }
      }
    },
