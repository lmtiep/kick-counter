        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chu kỳ có vẻ không đều"
          }
        }
      }
    },
    "cycle.late.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You could take a pregnancy test. If it is positive, tap “I'm pregnant”."
          }
