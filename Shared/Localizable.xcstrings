    "kicks.cardiff.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Count until you reach 10 movements and note how long it takes. Count at the same time each day to learn your baby's normal pattern. If 10 takes over 2 hours, or movements drop, call your doctor."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đếm đến khi đủ 10 cử động và xem mất bao lâu. Mỗi ngày đếm vào cùng khung giờ để biết nhịp bình thường của bé. Nếu quá 2 giờ chưa đủ 10, hoặc bé cử động ít hơn mọi ngày, hãy gọi bác sĩ."
          }
        }
      }
    },
